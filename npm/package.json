{
  "name": "@david-art-beep/deepresearch-cli",
  "version": "0.0.0",
  "description": "npm installer and launcher for the DeepResearch Python CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSenseNova/DeepResearch-CLI.git"
  },
  "homepage": "https://github.com/OpenSenseNova/DeepResearch-CLI#readme",
  "bugs": {
    "url": "https://github.com/OpenSenseNova/DeepResearch-CLI/issues"
  },
  "bin": {
    "deepresearch": "bin/deepresearch.js"
  },
